<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>VX Masker</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%}
body{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  font-family:Inter,Arial,sans-serif;
  background:#f7f7f8;
  color:#111;
}
#vx-bg{
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  z-index:0;
  pointer-events:none;
}
.vx-shell{
  position:relative;
  z-index:2;
  width:min(92vw,520px);
  padding:28px;
  border:1px solid rgba(0,0,0,.08);
  border-radius:24px;
  background:rgba(255,255,255,.88);
  backdrop-filter:blur(18px);
  box-shadow:0 24px 70px rgba(0,0,0,.12);
}
.vx-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:24px;
}
.vx-brand{
  display:flex;
  align-items:center;
  gap:12px;
}
.vx-logo{
  width:auto;height:86px;
  display:grid;place-items:center;
  border-radius:12px;
  background:#111;
  color:#fff;
  font-weight:800;
  letter-spacing:-1px;
}
h1{
  margin:0;
  font-size:26px;
  letter-spacing:-.8px;
}
.vx-sub{
  margin:4px 0 0;
  color:#666;
  font-size:13px;
}
.vx-grid{display:grid;gap:15px}
label{
  display:block;
  margin:0 0 7px;
  font-size:12px;
  font-weight:700;
  color:#3b3b3b;
  text-transform:uppercase;
  letter-spacing:.08em;
}
input,select{
  width:100%;
  height:48px;
  border:1px solid #dedede;
  border-radius:14px;
  padding:0 14px;
  background:#fff;
  color:#111;
  font-size:15px;
  outline:none;
  transition:.2s;
}
input[type=file]{
  padding:11px 12px;
  height:auto;
}
input:focus,select:focus{
  border-color:#111;
  box-shadow:0 0 0 3px rgba(0,0,0,.06);
}
.vx-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}
button{
  width:100%;
  height:50px;
  margin-top:6px;
  border:0;
  border-radius:15px;
  background:#111;
  color:#fff;
  font-size:15px;
  font-weight:800;
  cursor:pointer;
  transition:transform .16s ease,background .16s ease;
}
button:hover{background:#292929;transform:translateY(-1px)}
button:active{transform:translateY(0) scale(.99)}
.vx-note{
  margin-top:14px;
  text-align:center;
  color:#777;
  font-size:12px;
}
@media(max-width:560px){
  .vx-shell{padding:22px;border-radius:20px}
  .vx-row{grid-template-columns:1fr}
}

.vx-preset{position:relative;width:100%}
.vx-preset-button{margin:0;width:100%;height:48px;padding:0 13px;border:1px solid #dedede;border-radius:14px;background:#fff;color:#111;display:flex;align-items:center;justify-content:space-between;font-size:15px;font-weight:500;cursor:pointer;transition:.2s}
.vx-preset-button:hover{background:#fff;transform:none;border-color:#c9c9c9}
.vx-preset-button:focus{border-color:#111;box-shadow:0 0 0 3px rgba(0,0,0,.06);outline:none}
.vx-preset-selected,.vx-preset-option{display:flex;align-items:center;gap:10px}
.vx-chevron{font-size:18px;color:#777;line-height:1}
.vx-preset-menu{display:none;position:absolute;z-index:30;left:0;right:0;top:54px;max-height:310px;overflow:auto;padding:7px;background:#fff;border:1px solid #dedede;border-radius:14px;box-shadow:0 18px 45px rgba(0,0,0,.14)}
.vx-preset.open .vx-preset-menu{display:block}
.vx-preset-option{width:100%;height:40px;margin:0;padding:0 9px;border:0;border-radius:9px;background:#fff;color:#111;font-size:14px;font-weight:500;text-align:left;cursor:pointer}
.vx-preset-option:hover,.vx-preset-option:focus{background:#f2f2f3;transform:none;outline:none}
.vx-preset-icon,.vx-empty-icon{width:22px;height:22px;min-width:22px;border-radius:5px;object-fit:contain;background:#fff}
.vx-empty-icon{display:inline-block;border:1px solid #e5e5e5;background:linear-gradient(135deg,#fafafa,#eee)}

/* ===== VX Masker polished UI ===== */
:root{
  --vx-bg:#f5f5f7;
  --vx-card:rgba(255,255,255,.82);
  --vx-text:#111113;
  --vx-muted:#74747a;
  --vx-border:rgba(17,17,19,.09);
  --vx-soft:#f1f1f3;
  --vx-shadow:0 30px 80px rgba(0,0,0,.11),0 2px 10px rgba(0,0,0,.04);
}
body{
  background:
    radial-gradient(circle at 15% 15%,rgba(255,255,255,.95),transparent 34%),
    radial-gradient(circle at 85% 82%,rgba(225,225,230,.72),transparent 38%),
    var(--vx-bg);
  color:var(--vx-text);
}
#vx-bg{opacity:.72}
.vx-shell{
  width:min(92vw,560px);
  padding:30px;
  border:1px solid var(--vx-border);
  border-radius:26px;
  background:var(--vx-card);
  box-shadow:var(--vx-shadow);
  backdrop-filter:blur(24px) saturate(135%);
  -webkit-backdrop-filter:blur(24px) saturate(135%);
}
.vx-top{margin-bottom:26px}
.vx-brand{position:relative}
.vx-brand:after{
  content:"Create a clean masked tab";
  position:absolute;
  top:47px;
  left:50%;
  transform:translateX(-50%);
  white-space:nowrap;
  font-size:11px;
  font-weight:650;
  letter-spacing:.04em;
  color:#96969c;
}
.vx-logo{width:auto;height:86px;max-width:auto;object-fit:contain;background:none;border:0;border-radius:0}

.vx-grid{gap:16px;margin-top:38px}
label{
  margin:0 0 7px 2px;
  font-size:11px;
  font-weight:800;
  letter-spacing:.09em;
  color:#55555b;
}
input,select{
  height:50px;
  border:1px solid #dedee2;
  border-radius:14px;
  padding:0 15px;
  background:rgba(255,255,255,.94);
  font-size:14px;
  box-shadow:0 1px 2px rgba(0,0,0,.02);
}
input::placeholder{color:#aaaab0}
input:hover,select:hover{border-color:#c9c9ce}
input:focus,select:focus{
  border-color:#8f8f96;
  box-shadow:0 0 0 4px rgba(0,0,0,.045);
}
input[type=file]{
  min-height:50px;
  padding:12px 13px;
  color:#66666c;
}
input[type=file]::file-selector-button{
  border:0;
  border-radius:9px;
  padding:7px 10px;
  margin-right:10px;
  background:#ededf0;
  color:#252529;
  font-weight:700;
  cursor:pointer;
}
.vx-row{gap:13px}
#download{
  height:52px;
  margin-top:3px;
  border-radius:14px;
  background:linear-gradient(180deg,#202023,#0f0f11);
  box-shadow:0 8px 22px rgba(0,0,0,.15);
  letter-spacing:.01em;
}
#download:hover{
  background:linear-gradient(180deg,#2b2b2f,#171719);
  transform:translateY(-1px);
  box-shadow:0 11px 26px rgba(0,0,0,.18);
}
#download:active{transform:translateY(0) scale(.995)}
.vx-preset-button{
  height:50px;
  border-color:#dedee2;
  border-radius:14px;
  background:rgba(255,255,255,.94);
  padding:0 14px;
  font-size:14px;
  box-shadow:0 1px 2px rgba(0,0,0,.02);
}
.vx-preset-button:hover{border-color:#c9c9ce;background:#fff}
.vx-preset-menu{
  top:56px;
  max-height:330px;
  padding:8px;
  border:1px solid rgba(0,0,0,.09);
  border-radius:15px;
  box-shadow:0 22px 55px rgba(0,0,0,.17);
  scrollbar-width:thin;
}
.vx-preset-option{
  height:42px;
  padding:0 10px;
  border-radius:10px;
  font-size:14px;
}
.vx-preset-option:hover,.vx-preset-option:focus{background:#f1f1f3}
.vx-preset-icon,.vx-empty-icon{
  width:23px;height:23px;min-width:23px;border-radius:6px;
}
.vx-chevron{transition:transform .18s ease}
.vx-preset.open .vx-chevron{transform:rotate(180deg)}
.vx-field-hint{
  margin:7px 2px 0;
  color:#9999a0;
  font-size:11px;
  line-height:1.35;
}
.vx-footer{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  margin-top:16px;
  color:#a0a0a6;
  font-size:10px;
  font-weight:650;
  letter-spacing:.04em;
}
.vx-footer-logo{height:24px;width:auto;display:block;object-fit:contain}
.vx-footer-dot{width:4px;height:4px;border-radius:50%;background:#b8b8bd}
@media(max-width:560px){
  body{overflow:auto;padding:18px 0}
  .vx-shell{padding:23px;width:min(92vw,520px);border-radius:22px}
  .vx-grid{margin-top:36px}
}
</style>
</head>
<body>
<canvas id="vx-bg"></canvas>

<section class="vx-shell">
  <div class="vx-top">
    <div class="vx-brand" aria-label="VX MASKER">
      <img class="vx-logo" src="https://raw.githubusercontent.com/vxservice/maskercode/main/logo.png" alt="VX MASKER" draggable="false">
    </div>
  </div>

  <div class="vx-grid">
    <div>
      <label for="target">Target URL</label>
      <input id="target" type="text" placeholder="https://example.com" autocomplete="url" spellcheck="false">
      <div class="vx-field-hint">Enter the page you want the generated HTML to open.</div>
    </div>

    <div class="vx-row">
      <div>
        <label for="title">Tab title</label>
        <input id="title" type="text" placeholder="Custom title">
      </div>

      <div>
        <label for="preset">Preset</label>
        <div class="vx-preset" id="presetBox">
          <button type="button" class="vx-preset-button" id="presetButton" aria-haspopup="listbox" aria-expanded="false">
            <span class="vx-preset-selected"><span class="vx-empty-icon"></span><span>None</span></span>
            <span class="vx-chevron">⌄</span>
          </button>
          <div class="vx-preset-menu" id="presetMenu" role="listbox">
            <button type="button" class="vx-preset-option" data-value=""><span class="vx-empty-icon"></span><span>None</span></button>
          </div>
          <input type="hidden" id="preset" value="">
        </div>
      </div>
    </div>

    <div>
      <label for="favicon">Custom favicon</label>
      <input id="favicon" type="file" accept="image/*">
      <div class="vx-field-hint">Used only when no preset is selected.</div>
    </div>

    <button id="download">Create HTML</button>
  </div>
  <div class="vx-footer"><img class="vx-footer-logo" src="https://raw.githubusercontent.com/vxservice/maskercode/main/logo.png" alt="VX"><span class="vx-footer-dot"></span><span>LOCAL GENERATOR</span></div>
</section>

<script>
(() => {
  const c=document.getElementById("vx-bg");
  const x=c.getContext("2d");
  let w,h,pts=[];

  function resize(){
    w=c.width=innerWidth;
    h=c.height=innerHeight;
    const n=Math.max(35,Math.floor(w*h/12000));
    pts=Array.from({length:n},()=>({
      x:Math.random()*w,
      y:Math.random()*h,
      vx:(Math.random()-.5)*.16,
      vy:(Math.random()-.5)*.16
    }));
  }

  function draw(){
    x.clearRect(0,0,w,h);
    for(const p of pts){
      p.x+=p.vx;p.y+=p.vy;
      if(p.x<0)p.x=w;if(p.x>w)p.x=0;
      if(p.y<0)p.y=h;if(p.y>h)p.y=0;
    }
    for(let i=0;i<pts.length;i++){
      for(let j=i+1;j<pts.length;j++){
        const a=pts[i],b=pts[j];
        const d=Math.hypot(a.x-b.x,a.y-b.y);
        if(d<140){
          x.beginPath();
          x.moveTo(a.x,a.y);
          x.lineTo(b.x,b.y);
          x.strokeStyle=`rgba(0,0,0,${(1-d/140)*.10})`;
          x.lineWidth=.6;
          x.stroke();
        }
      }
    }
    for(const p of pts){
      x.beginPath();
      x.arc(p.x,p.y,1.2,0,Math.PI*2);
      x.fillStyle="rgba(0,0,0,.28)";
      x.fill();
    }
    requestAnimationFrame(draw);
  }

  addEventListener("resize",resize);
  resize();draw();
})();

const presets={
  apclassroom:{title:"AP Classroom",domain:"collegeboard.org"},
  blackboard:{title:"Blackboard Learn",domain:"blackboard.com"},
  blooket:{title:"Blooket",domain:"blooket.com"},
  brainpop:{title:"BrainPOP",domain:"brainpop.com"},
  canvas:{title:"Dashboard",domain:"instructure.com"},
  ck12:{title:"CK-12 Foundation",domain:"ck12.org"},
  clever:{title:"Clever | Portal",domain:"clever.com"},
  codeorg:{title:"Code.org",domain:"code.org"},
  collegeboard:{title:"College Board",domain:"collegeboard.org"},
  commonlit:{title:"CommonLit",domain:"commonlit.org"},
  coursera:{title:"Coursera",domain:"coursera.org"},
  deltamath:{title:"DeltaMath",domain:"deltamath.com"},
  desmos:{title:"Desmos | Graphing Calculator",domain:"desmos.com"},
  duolingo:{title:"Duolingo",domain:"duolingo.com"},
  edpuzzle:{title:"Edpuzzle",domain:"edpuzzle.com"},
  edx:{title:"edX",domain:"edx.org"},
  geogebra:{title:"GeoGebra",domain:"geogebra.org"},
  gmail:{title:"Inbox",domain:"mail.google.com"},
  classroom:{title:"Home",domain:"classroom.google.com"},
  docs:{title:"Untitled document - Google Docs",domain:"docs.google.com"},
  googleforms:{title:"Google Forms",domain:"docs.google.com"},
  googlemeet:{title:"Google Meet",domain:"meet.google.com"},
  googlesheets:{title:"Google Sheets",domain:"docs.google.com"},
  slides:{title:"Untitled presentation - Google Slides",domain:"docs.google.com"},
  ixl:{title:"IXL | Dashboard",domain:"ixl.com"},
  kahoot:{title:"Enter Game PIN - Kahoot!",domain:"kahoot.com"},
  khan:{title:"Khan Academy",domain:"khanacademy.org"},
  mathway:{title:"Mathway",domain:"mathway.com"},
  mcgrawhill:{title:"McGraw Hill",domain:"mheducation.com"},
  teams:{title:"Microsoft Teams",domain:"teams.microsoft.com"},
  newsela:{title:"Newsela",domain:"newsela.com"},
  noredink:{title:"NoRedInk",domain:"noredink.com"},
  onedrive:{title:"OneDrive",domain:"onedrive.live.com"},
  pearson:{title:"Pearson",domain:"pearson.com"},
  quizizz:{title:"Quizizz",domain:"quizizz.com"},
  quizlet:{title:"Quizlet",domain:"quizlet.com"},
  replit:{title:"Replit",domain:"replit.com"},
  schoology:{title:"Home | Schoology",domain:"schoology.com"},
  scratch:{title:"Scratch",domain:"scratch.mit.edu"},
  study:{title:"Study.com",domain:"study.com"},
  symbolab:{title:"Symbolab",domain:"symbolab.com"},
  turnitin:{title:"Turnitin",domain:"turnitin.com"},
  vocabulary:{title:"Vocabulary.com",domain:"vocabulary.com"},
  vxbrand:{title:"VX",domain:"",icon:"https://raw.githubusercontent.com/vxservice/maskercode/main/logo.png"},
  wikipedia:{title:"Wikipedia",domain:"wikipedia.org"},
  wolfram:{title:"Wolfram|Alpha",domain:"wolframalpha.com"}
};

const target=document.getElementById("target");
const title=document.getElementById("title");
const preset=document.getElementById("preset");
const favicon=document.getElementById("favicon");
const download=document.getElementById("download");

const presetBox=document.getElementById("presetBox");
const presetButton=document.getElementById("presetButton");
const presetMenu=document.getElementById("presetMenu");

const presetLabels = {"apclassroom": "AP Classroom", "blackboard": "Blackboard Learn", "blooket": "Blooket", "brainpop": "BrainPOP", "canvas": "Canvas", "ck12": "CK-12", "clever": "Clever", "codeorg": "Code.org", "collegeboard": "College Board", "commonlit": "CommonLit", "coursera": "Coursera", "deltamath": "DeltaMath", "desmos": "Desmos", "duolingo": "Duolingo", "edpuzzle": "Edpuzzle", "edx": "edX", "geogebra": "GeoGebra", "gmail": "Gmail", "classroom": "Google Classroom", "docs": "Google Docs", "googleforms": "Google Forms", "googlemeet": "Google Meet", "googlesheets": "Google Sheets", "slides": "Google Slides", "ixl": "IXL", "kahoot": "Kahoot", "khan": "Khan Academy", "mathway": "Mathway", "mcgrawhill": "McGraw Hill", "teams": "Microsoft Teams", "newsela": "Newsela", "noredink": "NoRedInk", "onedrive": "OneDrive", "pearson": "Pearson", "quizizz": "Quizizz", "quizlet": "Quizlet", "replit": "Replit", "schoology": "Schoology", "scratch": "Scratch", "study": "Study.com", "symbolab": "Symbolab", "turnitin": "Turnitin", "vocabulary": "Vocabulary.com", "vxbrand": "VX", "wikipedia": "Wikipedia", "wolfram": "Wolfram Alpha"};

const faviconURL = domain =>
  "https://www.google.com/s2/favicons?sz=64&domain=" + encodeURIComponent(domain);

for(const key of Object.keys(presets).sort((a,b)=>presetLabels[a].localeCompare(presetLabels[b]))){
  const p=presets[key];
  const b=document.createElement("button");
  b.type="button";
  b.className="vx-preset-option";
  b.dataset.value=key;

  const img=document.createElement("img");
  img.className="vx-preset-icon";
  img.src=p.icon||faviconURL(p.domain);
  img.alt="";
  img.loading="lazy";

  const span=document.createElement("span");
  span.textContent=presetLabels[key];

  b.append(img,span);
  presetMenu.appendChild(b);
}

function setPreset(value){
  preset.value=value;
  const p=presets[value];
  presetButton.querySelector(".vx-preset-selected").innerHTML="";
  const selected=presetButton.querySelector(".vx-preset-selected");

  if(p){
    const img=document.createElement("img");
    img.className="vx-preset-icon";
    img.src=p.icon||faviconURL(p.domain);
    img.alt="";
    const span=document.createElement("span");
    span.textContent=presetLabels[value];
    selected.append(img,span);
    title.value=p.title;
    favicon.disabled=true;
  }else{
    const empty=document.createElement("span");
    empty.className="vx-empty-icon";
    const span=document.createElement("span");
    span.textContent="None";
    selected.append(empty,span);
    favicon.disabled=false;
  }
  presetBox.classList.remove("open");
  presetButton.setAttribute("aria-expanded","false");
}

presetButton.addEventListener("click",()=>{
  const open=presetBox.classList.toggle("open");
  presetButton.setAttribute("aria-expanded",String(open));
});

presetMenu.addEventListener("click",e=>{
  const option=e.target.closest(".vx-preset-option");
  if(option)setPreset(option.dataset.value);
});

document.addEventListener("click",e=>{
  if(!presetBox.contains(e.target)){
    presetBox.classList.remove("open");
    presetButton.setAttribute("aria-expanded","false");
  }
});

const dataURL=file=>new Promise((resolve,reject)=>{
  const r=new FileReader();
  r.onload=()=>resolve(r.result);
  r.onerror=reject;
  r.readAsDataURL(file);
});

const esc=s=>String(s)
  .replaceAll("&","&amp;")
  .replaceAll("<","&lt;")
  .replaceAll(">","&gt;")
  .replaceAll('"',"&quot;");

download.addEventListener("click",async()=>{
  let url=target.value.trim();
  if(!url){alert("Enter a target URL or DATA URL first.");return;}

  // DATA URL support: decode the HTML and download it directly.
  if(/^data:text\/html/i.test(url)){
    try{
      const comma=url.indexOf(",");
      if(comma<0)throw new Error("Invalid DATA URL");

      const meta=url.slice(0,comma);
      const payload=url.slice(comma+1);
      let decodedHTML="";

      if(/;base64/i.test(meta)){
        const binary=atob(payload.replace(/\s/g,""));
        const bytes=Uint8Array.from(binary,ch=>ch.charCodeAt(0));
        decodedHTML=new TextDecoder("utf-8").decode(bytes);
      }else{
        decodedHTML=decodeURIComponent(payload);
      }

      const blob=new Blob([decodedHTML],{type:"text/html;charset=utf-8"});
      const href=URL.createObjectURL(blob);
      const a=document.createElement("a");
      a.href=href;
      a.download="vx-games.html";
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(()=>URL.revokeObjectURL(href),1000);
      return;
    }catch(error){
      console.error(error);
      alert("VX Masker couldn't decode this DATA URL.\n\n"+error.message);
      return;
    }
  }

  // Existing normal website behavior.
  if(!/^https?:\/\//i.test(url))url="https://"+url;

  let tabTitle=title.value.trim()||"VX Page";
  let icon="";
  const p=presets[preset.value];

  if(p){
    icon=p.icon||("https://www.google.com/s2/favicons?sz=64&domain="+encodeURIComponent(p.domain));
  }else if(favicon.files[0]){
    icon=await dataURL(favicon.files[0]);
  }

  const output=`<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>${esc(tabTitle)}</title>
${icon?`<link rel="icon" href="${esc(icon)}">`:""}
<style>
html,body{margin:0;width:100%;height:100%;overflow:hidden}
iframe{width:100%;height:100%;border:0;display:block}
</style>
</head>
<body>
<iframe src="${esc(url)}" allowfullscreen></iframe>
</body>
</html>`;

  const blob=new Blob([output],{type:"text/html"});
  const href=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=href;
  a.download="vx-page.html";
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(()=>URL.revokeObjectURL(href),1000);
});

// Polished UX helpers
target.addEventListener("keydown",e=>{
  if(e.key==="Enter") download.click();
});
title.addEventListener("keydown",e=>{
  if(e.key==="Enter") download.click();
});
const originalDownloadText=download.textContent;
download.addEventListener("click",()=>{
  setTimeout(()=>{
    download.textContent="Created ✓";
    setTimeout(()=>download.textContent=originalDownloadText,1300);
  },80);
});
</script>
</body>
